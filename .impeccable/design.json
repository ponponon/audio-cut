    "narrative": {
      "northStar": "安静的私人剪辑台",
      "overview": "参考 iOS「语音备忘录」的熟悉工具感。系统字体、柔和森林绿和少量表面层级把注意力放在波形、起止时间、试听和导出；底部导出操作以悬浮圆角胶囊和一层模糊半透明呈现轻量玻璃感。",
      "keyCharacteristics": [
        "跟随系统浅色和深色外观。",
        "波形和剪辑范围优先呈现。",
        "使用柔和的微信绿系森林绿，并保持按钮文字对比。",
        "只在底部导出栏使用轻量模糊玻璃效果。",
        "支持系统动态字号和清晰对比。",
        "本机隐私说明简短可见。"
      ],
      "rules": [
        {
          "name": "Quiet Utility",
          "section": "Overview",
          "body": "用户第一眼找到波形、起止时间和导出操作；不先读宣传文案。"
        },
        {
          "name": "One Accent",
          "section": "Colors",
          "body": "森林绿只表示主要操作、选区和播放进度。"
        },
        {
          "name": "System Type",
          "section": "Typography",
          "body": "遵循系统字号缩放；大字号下时间控件纵向排列。"
        },
        {
          "name": "Flat Surface",
          "section": "Elevation",
          "body": "通过中性色表面和分隔线建立层次；玻璃模糊只出现在底部导出栏。"
        },
        {
          "name": "Single Glass",
          "section": "Elevation",
          "body": "只在安全区内固定的 22dp 圆角底部导出操作使用裁切后的 14dp 背景模糊，保留清晰不透明的按钮内容。"
        }
      ],
      "dos": [
        "让波形、起止时间和试听成为编辑页的视觉中心。",
        "支持动态字号、可读对比度和足够大的触控区域。",
        "跟随系统浅色与深色外观。",
        "只在底部导出栏使用轻量磨砂玻璃，波形和编辑内容保持清晰。"
      ],
      "donts": [
        "复刻旧版近黑背景、高饱和薄荷绿大按钮、多层大圆角卡片和口号式大标题。",
        "堆叠大卡片或加入与剪辑无关的装饰。",
        "在波形或整页上重复施加模糊效果。",
        "增加登录、自动同步、上传或远程分析入口。"
      ]
